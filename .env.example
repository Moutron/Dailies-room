GCP_PROJECT_ID=your-project-id
GCP_LOCATION=us-central1
GCS_BUCKET=dailies-room-dailies

# google-genai (used by the ADK agent and pipeline/embed.py,
# pipeline/understand.py) needs its OWN env vars to route through Vertex AI
# instead of the public Gemini API — these are the SDK's fixed names, not
# ours, so they can't just reuse GCP_PROJECT_ID/GCP_LOCATION above.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Service account impersonated to sign GCS playback URLs (ui/server/clips.py).
# Needs roles/iam.serviceAccountTokenCreator on itself (or granted to whoever
# signs locally) and roles/storage.objectViewer on GCS_BUCKET.
GCS_SIGNER_SA=766122679114-compute@developer.gserviceaccount.com

GEMINI_VIDEO_MODEL=
GEMINI_AGENT_MODEL=

CLICKHOUSE_HOST=sus54l5t8w.us-central1.gcp.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
# Never fill this in — python-dotenv does NOT strip inline "key=value #
# comment" comments, so anything after "=" on this line becomes the
# literal password value (confirmed: this silently broke the Secret
# Manager fallback in agent/config.py::ch_password() during the Phase 9
# clean-clone test). Leave it truly empty, comment on its own line only.
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=DailiesRoom
# CLICKHOUSE_SECURE=false   # only for the local Docker fallback (docs/RUNBOOK.md) — ClickHouse Cloud always needs TLS (default true)
